# Configurer ces valeurs dans les secrets hébergés Sites, jamais dans le code.
# Tant que le compte et les autorisations ne sont pas raccordés, paiements désactivés.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_RUN_SECRET=
BILLING_WORKSPACE_ID=
BILLING_MODE=test
BILLING_SCHEDULER_ENABLED=false
BILLING_LIVE_APPROVED=false

# Identité du vrai collecteur, accepté pour cet usage par le prestataire et la banque.
BILLING_COLLECTOR_NAME=
BILLING_COLLECTOR_VERIFIED=false
# Après essais des notifications et relances chez le prestataire.
BILLING_RECOVERY_CONFIGURED=false

# Contrôle facultatif des accès : true = approbation manuelle ; false = inscription directe.
# Avec false, les profils connectés rejoignent le seul cercle ACCESS_DEFAULT_WORKSPACE_ID.
# Les identifiants administrateurs restent explicites, jamais une adresse seule.
ACCESS_CONTROL_ENABLED=true
ACCESS_ADMIN_USER_IDS=
ACCESS_DEFAULT_WORKSPACE_ID=
ADMIN_NOTIFICATION_EMAIL=
# Service Google Apps Script : identité Google et audience propres au projet autorisé.
NOTIFICATIONS_GOOGLE_EMAIL=
NOTIFICATIONS_GOOGLE_AUDIENCE=
NOTIFICATIONS_DELIVERY_ENABLED=false
# Connexion email + mot de passe choisi ; codes limités à la vérification et à la récupération.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
AUTH_EMAIL_ENABLED=false
